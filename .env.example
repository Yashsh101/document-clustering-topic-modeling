# Environment variables for document clustering project
# Copy to .env and set appropriate values

# Data configuration
DATA_INPUT_DIR=
DATA_OUTPUT_DIR=

# Preprocessing configuration
PREPROCESS_LOWERCASE=
PREPROCESS_REMOVE_PUNCTUATION=
PREPROCESS_REMOVE_NUMBERS=
PREPROCESS_REMOVE_STOPWORDS=
PREPROCESS_LEMMATIZE=

# Vectorization configuration
VECTORIZER_MAX_FEATURES=
VECTORIZER_MIN_DF=
VECTORIZER_MAX_DF=

# Clustering configuration
CLUSTERING_N_CLUSTERS=
CLUSTERING_RANDOM_STATE=
CLUSTERING_MAX_ITER=

# Topic modeling configuration
TOPIC_N_TOPICS=
TOPIC_MAX_ITER=

# Logging
LOG_LEVEL=
